# ═══════════════════════════════════════════════════
# INFUSION PLATFORM — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────
POSTGRES_DB=infusion
POSTGRES_USER=infusion
POSTGRES_PASSWORD=changeme

# ── Logging ───────────────────────────────────────
LOG_LEVEL=info

# ── Symbol Universe ──────────────────────────────
# Options: nifty50 | nifty100 | nifty200 | nifty500 | custom
SYMBOL_UNIVERSE=nifty200

# ── Broker Selection ─────────────────────────────
# Options: mock | upstox
BROKER_PRIMARY=upstox

# ── Kite (Zerodha) Credentials ──────────────────
# Get from: https://developers.kite.trade
REMOVED_KITE_API_KEY=
REMOVED_KITE_API_SECRET=
# Access token (optional — can use OAuth flow instead)
# Token refreshed daily via: http://localhost:5100/auth/login-urls
REMOVED_KITE_ACCESS_TOKEN=

# ── Upstox Credentials ──────────────────────────
# Get from: https://developer.upstox.com
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Access token (optional — can use OAuth flow instead)
UPSTOX_ACCESS_TOKEN=

# ── Telegram Alerts ─────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI advisory layer (optional; scanner remains deterministic)
# Create a project API key at https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SEC=20
OPENAI_CACHE_TTL_SEC=300

# ═══════════════════════════════════════════════════
# PRODUCTION SETUP (Upstox)
# ═══════════════════════════════════════════════════
#
# 1. Set BROKER_PRIMARY=upstox
# 2. Set UPSTOX_API_KEY and UPSTOX_API_SECRET
# 3. Start services: docker compose up -d
# 4. Open login URL: http://localhost:5100/auth/login-urls
# 5. Click the Kite login link → authenticate → token stored
# 6. Verify: http://localhost:5100/auth/status
# 7. Restart ingestion: docker compose restart ingestion
#
# Token expires at ~6:00 AM IST next day.
# Re-login each morning before market open (9:00 AM IST).
#
# ═══════════════════════════════════════════════════
# DEVELOPMENT (Mock)
# ═══════════════════════════════════════════════════
#
# Default: BROKER_PRIMARY=mock
# No credentials needed. 5 synthetic symbols with random walk.
# Dashboard at http://localhost:3000
